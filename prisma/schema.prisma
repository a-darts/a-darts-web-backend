// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

// TournamentInfo 
enum GameModes {
  SINGLE
  WOMEN_SINGLES
  MEN_SINGLES
  MIXED_SINGLES
  YOUTH_SINGLES
  PAIRS
  WOMEN_PAIRS
  MEN_PAIRS
  MIXED_PAIRS
  YOUTH_PAIRS
  TEAMS
}

enum ScheduleTypes {
  KO
}

enum GameTypes {
  BEST_OF
  FIRST_TO
}

//

enum RegistrationStatus {
  OPEN
  CLOSED
}

model User {
  id           String     @id @db.Uuid
  email        String     @unique
  password     String?
  alias        String
  role         UserRole
  registeredAt DateTime
  deletedAt    DateTime?
  status       UserStatus

  playerProfile Player?

  @@map("users")
}

model Player {
  userId             String @id @db.Uuid
  registrationNumber String
  federation         String
  // Value object Season fields
  seasonStartYear    Int
  seasonEndYear      Int
  //

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("players")
}

model Tournament {
  id        String           @id @db.Uuid
  name      String
  createdAt DateTime
  status    TournamentStatus

  // Value object TournamentInfo fields
  infoPlace      String
  infoDateTime   DateTime
  infoMode       GameModes
  infoGame       String
  infoSchedule   ScheduleTypes
  infoMaxPlayers Int
  infoGameType   GameTypes
  infoNumLegs    Int
  infoNumSets    Int
  infoRules      String
  infoInfo       String
  infoFederation String
  //

  // Value object Registration fields
  registrationHasCheckIn                Boolean
  registrationStatus                    RegistrationStatus
  // RegistrationPeriod fields
  registrationPeriodStartsAt            DateTime?
  registrationPeriodEndsAt              DateTime?
  //
  registrationRegisteredParticipantsIds String[]
  //

  @@map("tournaments")
}

model RegisteredParticipant {
  id           String    @id @db.Uuid
  playerId     String    @db.Uuid
  registeredAt DateTime
  checkedInAt  DateTime?

  tournamentId String @db.Uuid

  // Índice para buscar rápido por id del jugador e id del torneo
  @@unique([playerId, tournamentId])
  // Índice para buscar rápido por id del jugador
  @@index([playerId])
  @@map("registeredParticipants")
}
