// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRoles {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

// TournamentInfo 
enum GameModes {
  SINGLE
  WOMEN_SINGLES
  MEN_SINGLES
  MIXED_SINGLES
  YOUTH_SINGLES
  PAIRS
  WOMEN_PAIRS
  MEN_PAIRS
  MIXED_PAIRS
  YOUTH_PAIRS
  TEAMS
}

enum ScheduleTypes {
  KO
}

enum GameTypes {
  BEST_OF
  FIRST_TO
}

//

enum RegistrationStatus {
  OPEN
  CLOSED
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  FINISHED
  SUSPENDED
  ABANDONED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  password     String?
  alias        String
  role         UserRoles
  registeredAt DateTime
  deletedAt    DateTime?
  status       UserStatus

  playerProfiles Player[]

  @@map("users")
}

model Player {
  id                 String @id @default(uuid()) @db.Uuid
  userId             String @db.Uuid
  registrationNumber String
  federation         String
  // Value object Season fields
  seasonStartYear    Int
  seasonEndYear      Int
  //

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonStartYear])
  @@map("players")
}

model Tournament {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime
  status    TournamentStatus

  // Value object TournamentInfo fields
  infoPlace      String
  infoDateTime   DateTime
  infoMode       GameModes
  infoGame       String
  infoSchedule   ScheduleTypes
  infoMaxPlayers Int?
  infoGameType   GameTypes
  infoNumLegs    Int
  infoNumSets    Int
  infoRules      String
  infoInfo       String
  infoFederation String
  //

  // Value object Registration fields
  registrationHasCheckIn                Boolean
  registrationStatus                    RegistrationStatus
  // RegistrationPeriod fields
  registrationPeriodStartsAt            DateTime?
  registrationPeriodEndsAt              DateTime?
  //
  registrationRegisteredParticipantsIds String[]
  //

  matchesIds String[]

  @@map("tournaments")
}

model RegisteredParticipant {
  id           String    @id @default(uuid()) @db.Uuid
  playerId     String    @db.Uuid
  registeredAt DateTime
  checkedInAt  DateTime?

  tournamentId String @db.Uuid

  @@unique([playerId, tournamentId])
  // Índice para buscar rápido por id del jugador
  @@index([playerId])
  @@map("registeredParticipants")
}

model Match {
  id          String      @id @default(uuid()) @db.Uuid
  round       Int
  boardNumber Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  status      MatchStatus @default(PENDING)

  participant1Id String @db.Uuid
  participant2Id String @db.Uuid

  matchScoreParticipant1SetsWon Int @default(0)
  matchScoreParticipant1LegsWon Int @default(0)

  matchScoreParticipant2SetsWon Int @default(0)
  matchScoreParticipant2LegsWon Int @default(0)

  tournamentId String @db.Uuid // Para garantizar enfrentamientos únicos en un torneo

  // Garantiza partidos únicos en un torneo
  @@unique([tournamentId, participant1Id, participant2Id])
  // Índices para consultas más rápidas
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([tournamentId])
  //
  @@map("matches")
}
