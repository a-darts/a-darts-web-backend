generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  player
  admin
}

enum UserStatus {
  active
  inactive
  blocked
  deleted
}

model User {
  id            String     @id @db.Uuid
  email         String     @unique
  password      String?
  alias         String
  role          UserRole
  registratedAt DateTime
  deletedAt     DateTime?
  status        UserStatus

  playerProfile Player?

  @@map("users")
}

model Player {
  userId             String @id @db.Uuid
  registrationNumber String
  federation         String
  // Value object Season fields
  seasonStartYear    Int
  seasonEndYear      Int
  //

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("players")
}
