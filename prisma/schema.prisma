// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRoles {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

// TournamentInfo 
enum GameModes {
  SINGLE
  WOMEN_SINGLES
  MEN_SINGLES
  MIXED_SINGLES
  YOUTH_SINGLES
  PAIRS
  WOMEN_PAIRS
  MEN_PAIRS
  MIXED_PAIRS
  YOUTH_PAIRS
  TEAMS
}

enum ScheduleTypes {
  KO
}

enum GameTypes {
  BEST_OF
  FIRST_TO
}

//

enum RegistrationStatus {
  OPEN
  CLOSED
}

enum MatchStatus {
  PENDING
  READY
  IN_PROGRESS
  FINISHED
  SUSPENDED
  CANCELLED
}

enum BracketStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum BoardStatus {
  AVAILABLE
  OCCUPIED
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  password     String?
  alias        String
  role         UserRoles
  registeredAt DateTime
  deletedAt    DateTime?
  status       UserStatus

  playerProfiles Player[]

  @@map("users")
}

model Player {
  id                 String @id @default(uuid()) @db.Uuid
  userId             String @db.Uuid
  registrationNumber String
  federation         String
  // Value object Season fields
  seasonStartYear    Int
  //

  // Integridad referencial
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations     RegisteredParticipant[]
  tournamentResults TournamentResult[]

  @@unique([userId, seasonStartYear])
  @@map("players")
}

model Tournament {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  // Value object Season fields
  seasonStartYear Int
  //
  createdAt       DateTime
  status          TournamentStatus

  // Value object TournamentInfo fields
  infoPlace      String
  infoDateTime   DateTime
  infoMode       GameModes
  infoGame       String
  infoSchedule   ScheduleTypes
  infoMaxPlayers Int?
  infoGameType   GameTypes
  infoNumLegs    Int
  infoNumSets    Int
  infoRules      String
  infoInfo       String
  infoFederation String
  //

  // Value object Registration fields
  registrationHasCheckIn                Boolean
  registrationStatus                    RegistrationStatus
  // RegistrationPeriod fields
  registrationPeriodStartsAt            DateTime?
  registrationPeriodEndsAt              DateTime?
  //
  registrationRegisteredParticipantsIds String[]
  //

  // Integridad referencial
  bracket                Bracket?
  playingArea            PlayingArea?
  registeredParticipants RegisteredParticipant[]
  matches                Match[]
  tournamentResults      TournamentResult[]

  @@map("tournaments")
}

model RegisteredParticipant {
  id           String    @id @default(uuid()) @db.Uuid
  playerId     String    @db.Uuid
  registeredAt DateTime
  checkedInAt  DateTime?

  tournamentId String @db.Uuid

  // Integridad referencial
  player            Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracketPositions  BracketPosition[]
  matchesAsP1       Match[]            @relation("MatchParticipant1")
  matchesAsP2       Match[]            @relation("MatchParticipant2")
  tournamentResults TournamentResult[]

  @@unique([playerId, tournamentId])
  // Índice para buscar rápido por id del jugador
  @@index([playerId])
  @@map("registeredParticipants")
}

model Match {
  id         String      @id @default(uuid()) @db.Uuid
  round      Int
  matchIndex Int
  startedAt  DateTime?
  finishedAt DateTime?
  status     MatchStatus @default(PENDING)

  participant1Id String? @db.Uuid
  participant2Id String? @db.Uuid

  isParticipant1Bye Boolean
  isParticipant2Bye Boolean

  matchScoreParticipant1SetsWon Int @default(0)
  matchScoreParticipant1LegsWon Int @default(0)

  matchScoreParticipant2SetsWon Int @default(0)
  matchScoreParticipant2LegsWon Int @default(0)

  tournamentId String @db.Uuid

  // Integridad referencial
  tournament   Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant1 RegisteredParticipant? @relation("MatchParticipant1", fields: [participant1Id], references: [id])
  participant2 RegisteredParticipant? @relation("MatchParticipant2", fields: [participant2Id], references: [id])
  board        Board?

  // Índices para consultas más rápidas
  @@index([participant1Id])
  @@index([participant2Id])
  @@index([tournamentId])
  //
  @@map("matches")
}

model Bracket {
  id     String        @id @default(uuid()) @db.Uuid
  status BracketStatus

  tournamentId String @unique @db.Uuid

  // Integridad referencial
  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  positions  BracketPosition[]

  @@map("brackets")
}

model BracketPosition {
  id            String  @id @default(uuid()) @db.Uuid
  position      Int
  participantId String? @db.Uuid // Sólo si es participante real (no Bye)
  isBye         Boolean

  bracketId String @db.Uuid

  // Integridad referencial
  participant RegisteredParticipant? @relation(fields: [participantId], references: [id])
  bracket     Bracket                @relation(fields: [bracketId], references: [id], onDelete: Cascade)

  @@unique([bracketId, position])
  @@map("bracketPositions")
}

model PlayingArea {
  id           String @id @default(uuid()) @db.Uuid
  shortId      String @unique
  tournamentId String @unique @db.Uuid

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  boards     Board[]

  @@map("playingAreas")
}

model Board {
  id            String      @id @default(uuid()) @db.Uuid
  number        Int
  status        BoardStatus
  matchId       String?     @unique @db.Uuid
  playingAreaId String      @db.Uuid

  playingArea PlayingArea @relation(fields: [playingAreaId], references: [id], onDelete: Cascade)
  match       Match?      @relation(fields: [matchId], references: [id])

  @@unique([playingAreaId, number])
  @@map("boards")
}

model TournamentResult {
  id            String @id @default(uuid()) @db.Uuid
  tournamentId  String @db.Uuid
  participantId String @db.Uuid
  playerId      String @db.Uuid

  finalPosition Int
  matchesWon    Int
  matchesLost   Int
  setsWon       Int
  setsLost      Int
  legsWon       Int
  legsLost      Int

  tournament  Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participant RegisteredParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  player      Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, participantId])
  @@map("tournamentResults")
}
